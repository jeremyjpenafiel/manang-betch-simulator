  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "How to Play\r\nBasic Controls\r\n\r\n    Move \u2013 Use the WASD keys
    to move your character around the world:\r\n\r\n        W \u2013 Move Forward\r\n\r\n       
    A \u2013 Move Left\r\n\r\n        S \u2013 Move Backward\r\n\r\n        D \u2013
    Move Right\r\n\r\n    Interact \u2013 Use the Left Mouse Button to interact with
    objects. This includes picking things up, opening doors, pressing buttons, or
    triggering in-game actions.\r\n\r\n\n\nGame Phases\r\n\r\nThe game is divided
    into three phases, each with its own goals and pacing:\r\n\n1. Preparation Phase\r\n\r\n   
    Take time to explore the kitchen and familiarize yourself with the layout.\r\n\r\n   
    Identify key stations like ingredients, the blackboard, dish display, the POS
    system, and trash bin.\r\n\r\n    No orders are active yet\u2014use this moment
    to buy all the ingredients you need and assemble all the dish you plan to sell.
    \n \n    Press the green button near the blackboard to start the next phase when
    ready.\n\r\n2. Order Phase\r\n    \n    Start of this phase officially starts
    at 8:00AM game time and ends at 5:00PM\n\r\n    NPCs begin to queue to order.\n\r\n   
    Quickly prepare dishes based on the order requirements.\r\n\r\n    Left-click
    to pick up dish and assemble the whole order.\r\n\r\n    Deliver correct dishes
    to the payment counter using the left mouse button.\r\n\n    Use the POS to register
    the respective order of the customer. \n\r\n    Incorrect dishes cannot be returned
    to the display. Dispose of them in the trash bin to avoid food poisoning.\r\n\r\n3.
    Cleanup Phase\r\n\r\n    Once the final order is completed, the game enters cleanup.\r\n\r\n   
    Dispose of any remaining dishes.\r\n\r\n    Press the red button near the blackboard
    to end day when ready."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 73f0ef2eaaf95f24bab510cad5d82f03, type: 2}
  m_sharedMaterial: {fileID: -200649084991866180, guid: 73f0ef2eaaf95f24bab510cad5d82f03, type: 2}
